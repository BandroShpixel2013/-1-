const o=order(),pos=o.filter(x=>!x.dnf).indexOf(P)+1;g.textAlign='left';g.fillStyle='#000a';g.fillRect(8,8,138,68);g.fillStyle='#fff';g.font='bold 22px sans-serif';g.fillText(P.dnf?'DNF':'P'+pos+'/'+o.filter(x=>!x.dnf).length,16,34);
g.font='13px sans-serif';g.fillText('Круг '+Math.min(LAPS,Math.max(1,P.cr))+'/'+LAPS+' · '+Math.round(P.v*1.2)+' км/ч',16,56);g.fillStyle='#444';g.fillRect(16,63,100,6);g.fillStyle=P.tire>.45?'#3c3':'#e33';g.fillRect(16,63,100*P.tire,6);if(P.want||P.pit){g.fillStyle='#fd0';g.fillText(P.pit?'ПИТ-СТОП':'ПИТ',94,32)}
g.fillStyle='#000a';g.fillRect(W-86,8,78,12+Math.min(5,o.length)*16);g.font='11px sans-serif';
o.slice(0,5).forEach((c,i)=>{g.fillStyle=c.dnf?'#555':TM[c.t][1];g.fillRect(W-80,16+i*16,6,11);g.fillStyle=c.dnf?'#777':'#fff';g.fillText((i+1)+' '+c.dv[1],W-70,26+i*16)});
if(cd>0||go0<1){g.textAlign='center';g.font='bold 80px sans-serif';g.fillStyle=cd>0?'#fff':'#3f3';g.fillText(cd>0?Math.ceil(cd):'GO!',W/2,H/2-60)}}
