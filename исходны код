if(Math.random()<0.0016){g.fillStyle='#fff';g.beginPath();g.arc(seat.x,seat.y-bob-3,3,0,7);g.fill()}
});
if(Math.random()<0.004){const f=st.seats[Math.floor(Math.random()*st.seats.length)];g.fillStyle='rgba(255,120,60,0.24)';g.beginPath();g.arc(f.x,f.y-7,4+Math.random()*4,0,7);g.fill()}
});
sparks.forEach(sp=>{g.fillStyle='rgba(255,'+Math.floor(150+Math.random()*105)+',0,'+sp[4]+')';g.fillRect(sp[0],sp[1],1.4,1.4)});
cars.forEach(c=>{
