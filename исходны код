r.style.display='block';$('a1').onclick=()=>{if(sea){if(sea.i+1<SN){sea.i++;start()}else{clearSave();$('a2').click()}}else start()};$('a2').onclick=()=>{r.style.display='none';$('menu').style.display='block';S='menu';sel()}}
function draw(){g.fillStyle='#1d5a30';g.fillRect(0,0,W,H);if(!pts||S=='menu')return;
