function near(c){let b=1e9,bi=c.idx;for(let j=-8;j<=8;j++){const i=(c.idx+j+N)%N,d=(pts[i][0]-c.x)**2+(pts[i][1]-c.y)**2;if(d<b){b=d;bi=i}}
if(c.idx>N*.75&&bi<N*.25){c.cr++;if(c.cr==LAPS+1&&!c.fin)c.fin=++fc}else if(c.idx<N*.25&&bi>N*.75)c.cr--;c.idx=bi;c.off=Math.sqrt(b)}
function barrier(c,dt){
if(c.off>BAR){
const over=c.off-BAR;
const p=ptAt(c.idx),nx=(c.x-p[0]),ny=(c.y-p[1]),nd=Math.hypot(nx,ny)||1;
const ux=nx/nd,uy=ny/nd;
c.x-=ux*(over+0.6);c.y-=uy*(over+0.6);
const pen=Math.min(1,over/6);
c.v*=Math.max(0.35,1-0.5*pen);
c.dmg+=pen*dt*6;
if(Math.random()<pen*0.8){sparks.push([c.x+ux*BAR*0.6,c.y+uy*BAR*0.6,Math.random()*6-3,Math.random()*6-3,0.35])}
if(c.v>140&&Math.random()<pen*0.006)c.dmg+=6;
return true}
return false}
function step(c,dt){
if(c.dnf){c.dnfT+=dt;return}
if(c.pit){pitStep(c,dt);near(c);return}
if(!c.pl&&c.tire<.45)c.want=1;
if(c.want&&c.cr>=1&&c.cr<LAPS&&c.idx>=N-16&&c.idx<N-8){c.pit=1;c.pf=c.idx-N;c.done=0;return}
c.tire=Math.max(0,c.tire-dt*.012);
c.rel=Math.max(0,c.rel-dt*(1.0-TM[c.t][2])*0.010);
const cap=c.mx*(.7+.3*c.tire)*(c.off>TW/2+4?.45:1);let s;
if(c.pl){s=(K.r?1:0)-(K.l?1:0);if(K.g||touch)c.v+=170*dt;else c.v-=50*dt;if(K.b)c.v-=330*dt}
else{const q=pts[(c.idx+5)%N],d=nrm(Math.atan2(q[1]-c.y,q[0]-c.x)-c.a);s=Math.max(-1,Math.min(1,d*2));const w=cap*(1-.55*cu[c.idx])*c.sk;c.v+=(c.v<w?150:-260)*dt}
if(c.v>cap)c.v-=250*dt;if(c.v<0)c.v=0;
c.a+=s*2.8*dt*Math.min(1,c.v/90);c.x+=Math.cos(c.a)*c.v*dt;c.y+=Math.sin(c.a)*c.v*dt;near(c);
const hit=barrier(c,dt);
if(c.rel<=0&&!c.fin){c.dnf=1;c.v=0}
if(c.dmg>100&&!c.fin){c.dnf=1;c.v=0}
}
const prog=c=>c.fin?1e9-c.fin:c.dnf?-1:c.cr*N+c.idx;
function standHTML(){if(!sea)return'';const s=TM.map((_,t)=>t).sort((a,b)=>sea.sc[b]-sea.sc[a]),e=sea.i+1>=SN;
return`<h2>Зачёт пилотов и команд · этап ${sea.i+1}/${SN}</h2>${e?`<h1 style="margin-bottom:8px">🏆 Чемпион: <span>${DR[s[0]][sea.dv[s[0]]][0]}</span></h1>`:''}`+s.map((t,i)=>`<div class="${t==pi?'me':''}" style="--c:${TM[t][1]}"><b>${i+1}</b><span>${DR[t][sea.dv[t]][1]} · ${TM[t][0]}</span><em style="margin-left:auto">${sea.sc[t]}</em></div>`).join('')}
function ptAt(f){f=((f%N)+N)%N;const i=Math.floor(f),t=f-i,A=pts[i],B=pts[(i+1)%N];return[A[0]+(B[0]-A[0])*t,A[1]+(B[1]-A[1])*t,Math.atan2(B[1]-A[1],B[0]-A[0])]}
function off(f,l){const p=ptAt(f);return[p[0]-Math.sin(p[2])*l,p[1]+Math.cos(p[2])*l]}
function pitStep(c,dt){const bx=-7+2*(c.dv===DR[c.t][0]?0:1);
if(c.stop>0){c.stop-=dt;c.v=0;if(c.stop<=0){c.stop=0;c.tire=1;c.want=0;c.dmg=Math.max(0,c.dmg-30)}}
else{c.v=Math.min(c.v+150*dt,90);const p=c.pf;c.pf+=c.v*dt/20;if(!c.done&&p<bx&&c.pf>=bx){c.pf=bx;c.stop=2.2;c.v=0;c.done=1}}
const l=Math.max(0,Math.min(TW/2+16,(c.pf+16)*12,(17-c.pf)*12)),p=off(c.pf,l);c.x=p[0];c.y=p[1];c.a=ptAt(c.pf)[2];
