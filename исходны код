function mkStands(){
const o=[];const cl=['#ff4d4d','#ffd84d','#4da6ff','#fff','#7cff7c','#ff8c1a','#ff87bc','#27f4d2'];
const stepS=Math.max(14,Math.floor(N/5));
let bi=0;
for(let s=20;s<N-20;s+=stepS){
for(const side of[-1,1]){
for(let tier=0;tier<3;tier++){
const base=BAR+14+tier*10;
const seats=[];
for(let j=-8;j<=8;j++){
const f=s+j*0.85;
const p=off(f,side*base);
if(pts.some(q=>(q[0]-p[0])**2+(q[1]-p[1])**2<(TW/2+10)**2))continue;
const tc=cl[(Math.floor(s/stepS)*3+tier+j+10)%cl.length];
seats.push({x:p[0],y:p[1],c:tc,ph:Math.random()*Math.PI*2,
flag:Math.random()<0.08?TM[Math.floor(Math.random()*TM.length)][1]:null});
}
if(seats.length>2)o.push({type:'stand',side,s,tier,base,seats});
}
}
// плакат команды между секциями (только внешняя сторона)
const team=TM[bi%TM.length];bi++;
const p=off(s+stepS*0.5, (BAR+6));
if(!pts.some(q=>(q[0]-p[0])**2+(q[1]-p[1])**2<(TW/2+8)**2)){
o.push({type:'banner',x:p[0],y:p[1],a:ptAt(s+stepS*0.5)[2],team,ph:Math.random()*Math.PI*2});
}
}
return o}
function mkFans(){return[]}
function update(dt){if(S!='race')return;if(cd>0){cd-=dt;if(cd<=0)go0=1;return}go0+=dt;
if(K.p)P.want=1;cars.forEach(c=>step(c,dt));
for(let i=0;i<cars.length;i++)for(let j=i+1;j<cars.length;j++){const a=cars[i],b=cars[j];if(a.dnf||b.dnf)continue;const dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy);if(d<20&&d>.01&&!a.pit&&!b.pit){const p=(20-d)/2,nx=dx/d,ny=dy/d;a.x-=nx*p;a.y-=ny*p;b.x+=nx*p;b.y+=ny*p;a.v*=.985;b.v*=.985}}
for(let i=sparks.length-1;i>=0;i--){const s=sparks[i];s[0]+=s[2];s[1]+=s[3];s[4]-=dt;if(s[4]<=0)sparks.splice(i,1)}
if(P.dnf&&!P.fin){S='done';setTimeout(results,1400)}
else if(P.fin){S='done';setTimeout(results,1200)}}
