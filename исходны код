g.fillStyle=TM[c.t][1];g.fillRect(-11,-4.5,22,9);g.fillStyle='#111';g.fillRect(-12,-6,3,12);g.fillRect(9,-6,3,12);g.fillStyle='#000';g.beginPath();g.arc(-1,0,3,0,7);g.fill();
if(c.pl){g.strokeStyle=c.dnf?'#888':'#fff';g.lineWidth=1.5;g.strokeRect(-12,-7,24,14)}
g.restore();
g.fillStyle=c.dnf?'#888':'#fff';g.font='bold 8px sans-serif';g.textAlign='center';g.fillText(c.dv[1],c.x,c.y-12);
if(c.dnf){g.fillStyle='#f33';g.font='bold 7px sans-serif';g.fillText('DNF',c.x,c.y+14)}});
