{n:'🇦🇪 Абу-Даби',c:24,p:[[0,0],[450,0],[700,-40],[800,60],[700,150],[560,100],[460,200],[620,300],[500,400],[250,370],[150,260],[-80,300],[-150,150]]},
{n:'Спринт-овал',p:[[0,0],[400,-20],[700,60],[800,260],[650,400],[350,380],[200,480],[-100,420],[-200,200],[-150,50]]},
{n:'Зигзаг',p:[[0,0],[300,0],[500,-100],[700,0],[800,200],[600,300],[700,450],[450,550],[250,450],[300,300],[100,250],[-100,150],[-150,0]]},
{n:'Шиканы',p:[[0,0],[250,0],[400,80],[550,0],[750,0],[850,150],[750,300],[550,330],[450,250],[300,330],[100,320],[-50,200]]},
{n:'Сочи',p:[[0,0],[500,0],[620,60],[620,180],[700,260],[700,380],[600,460],[350,460],[250,380],[100,380],[0,300],[-100,200],[-100,60]]},
{n:'Нюрбургринг',p:[[0,0],[240,0],[340,70],[260,140],[360,220],[560,200],[700,280],[640,380],[440,360],[320,450],[100,430],[-60,340],[-20,230],[-180,150],[-160,30]]}
];
const CAL=TR.map((_,i)=>i).filter(i=>TR[i].c).sort((a,b)=>TR[a].c-TR[b].c);
const TM=[['Red Bull','#1e41ff',.99,'RBR'],['Ferrari','#e8002d',.98,'FER'],['Mercedes','#27f4d2',.98,'MER'],['McLaren','#ff8000',1,'MCL'],['Aston Martin','#229971',.95,'AMR'],['Alpine','#ff87bc',.92,'ALP'],['Williams','#64c4ff',.93,'WIL'],['Racing Bulls','#6692ff',.93,'RB'],['Audi','#b6bac5',.91,'AUD'],['Haas','#e6e6e6',.92,'HAA'],['Cadillac','#d4af37',.9,'CAD']];
const $=id=>document.getElementById(id),cv=$('c'),g=cv.getContext('2d'),TW=44,touch='ontouchstart' in window;
const DR=[[['Макс Ферстаппен','VER'],['Исак Аджар','HAD']],[['Шарль Леклер','LEC'],['Льюис Хэмилтон','HAM']],[['Джордж Расселл','RUS'],['Кими Антонелли','ANT']],[['Ландо Норрис','NOR'],['Оскар Пиастри','PIA']],[['Фернандо Алонсо','ALO'],['Лэнс Стролл','STR']],[['Пьер Гасли','GAS'],['Франко Колапинто','COL']],[['Алекс Элбон','ALB'],['Карлос Сайнс','SAI']],[['Лиам Лоусон','LAW'],['Арвид Линдблад','LIN']],[['Нико Хюлькенберг','HUL'],['Габриэл Бортолето','BOR']],[['Эстебан Окон','OCO'],['Оливер Бермен','BEA']],[['Серхио Перес','PER'],['Валттери Боттас','BOT']]];
const SKEY='miniF1_save_v1';
const BAR=TW/2+8;
let LAPS=5,di=0,fans=[],stands=[],mode=0,SN=5,sea=null;
let W,H,ti=0,pi=3,S='menu',pts,cu,N,cars,cd,go0,fc,K={},last=0,P,sparks=[];

function loadSave(){try{const r=localStorage.getItem(SKEY);if(!r)return null;const d=JSON.parse(r);if(!d||!d.sea)return null;return d}catch(e){return null}}
function saveSeason(){if(!sea)return;try{localStorage.setItem(SKEY,JSON.stringify({sea,mode,SN,pi,di,LAPS,ts:Date.now()}))}catch(e){}}
function clearSave(){try{localStorage.removeItem(SKEY)}catch(e){}}
function saveMeta(){const sv=loadSave();if(sv){localStorage.setItem(SKEY,JSON.stringify({...sv,mode,SN,pi,di,LAPS}))}}
function saveBoxHTML(){const sv=loadSave();if(!sv)return'';
const s=TM.map((_,t)=>t).sort((a,b)=>sv.sea.sc[b]-sv.sea.sc[a]);
const lead=s[0],me=sv.pi;
return`<div class="saveinfo">💾 <b>Сохранён чемпионат:</b> этап ${sv.sea.i+1}/${sv.SN} · лидер: ${DR[lead][sv.sea.dv[lead]][1]} (${TM[lead][0]}, ${sv.sea.sc[lead]} очк.)<br>Твоя команда: ${TM[me][0]} · пилот ${DR[me][sv.sea.dv[me]][0]}</div>
<button class="save" id="cont">ПРОДОЛЖИТЬ ЧЕМПИОНАТ →</button>
<button class="del" id="del">Удалить сохранение</button>`}
function rs(){const d=devicePixelRatio||1;W=innerWidth;H=innerHeight;cv.width=W*d;cv.height=H*d;g.setTransform(d,0,0,d,0,0)}
addEventListener('resize',rs);rs();
function sel(){$('tr').innerHTML=TR.map((t,i)=>`<button class="${i==ti?'on':''}" data-t="${i}">${t.n}</button>`).join('');
$('tm').innerHTML=TM.map((t,i)=>`<button class="team ${i==pi?'on':''}" style="--c:${t[1]}" data-m="${i}">${t[0]}</button>`).join('');$('dr').innerHTML=DR[pi].map((d,i)=>`<button class="${i==di?'on':''}" data-d="${i}">${d[0]}</button>`).join('');$('lp').innerHTML=[3,5,10].map(n=>`<button class="${n==LAPS?'on':''}" data-l="${n}">${n}</button>`).join('');$('md').innerHTML=['Быстрая гонка','🏆 Чемпионат 2026'].map((n,i)=>`<button class="${i==mode?'on':''}" data-o="${i}">${n}</button>`).join('');$('sn').innerHTML=[5,10,CAL.length].map(n=>`<button class="${n==SN?'on':''}" data-s="${n}">${n}</button>`).join('');$('trw').style.display=mode?'none':'';$('snw').style.display=mode?'':'none';$('go').textContent=mode?'НАЧАТЬ СЕЗОН':'СТАРТ';
$('savebox').innerHTML=saveBoxHTML();
const cb=$('cont');if(cb)cb.onclick=()=>{const sv=loadSave();if(!sv)return;sea=sv.sea;mode=sv.mode;SN=sv.SN;pi=sv.pi;di=sv.di;LAPS=sv.LAPS;$('menu').style.display='none';start()};
const db=$('del');if(db)db.onclick=()=>{clearSave();sel()}}
$('menu').onclick=e=>{const b=e.target.closest('button');if(!b)return;if(b.id=='cont'||b.id=='del')return;if(b.dataset.t)ti=+b.dataset.t;if(b.dataset.m){pi=+b.dataset.m;di=0}if(b.dataset.d)di=+b.dataset.d;if(b.dataset.l)LAPS=+b.dataset.l;if(b.dataset.o)mode=+b.dataset.o;if(b.dataset.s)SN=+b.dataset.s;saveMeta();sel()};
sel();
function build(p){const o=[],n=p.length;for(let i=0;i<n;i++){const a=p[(i+n-1)%n],b=p[i],c=p[(i+1)%n],d=p[(i+2)%n];const k2=Math.max(4,Math.ceil(Math.hypot(c[0]-b[0],c[1]-b[1])/20));for(let s=0;s<k2;s++){const t=s/k2,t2=t*t,t3=t2*t;o.push([0,1].map(k=>.5*(2*b[k]+(-a[k]+c[k])*t+(2*a[k]-5*b[k]+4*c[k]-d[k])*t2+(-a[k]+3*b[k]-3*c[k]+d[k])*t3)))}}return o}
const nrm=d=>Math.atan2(Math.sin(d),Math.cos(d));
function start(){if(sea)ti=CAL[sea.i];pts=build(TR[ti].p);N=pts.length;
const c0=pts.map((_,i)=>{const a=pts[(i+3)%N],b=pts[i],c=pts[(i+6)%N],d=pts[(i+10)%N];return Math.min(1,Math.abs(nrm(Math.atan2(d[1]-c[1],d[0]-c[0])-Math.atan2(a[1]-b[1],a[0]-b[0])))/1.1)});
cu=c0.map((_,i)=>{let m=0;for(let j=-2;j<9;j++)m=Math.max(m,c0[(i+j+N)%N]);return m});
const entries=[];
TM.forEach((_,t)=>{entries.push({t,dv:0},{t,dv:1})});
const meIdx=entries.findIndex(e=>e.t==pi&&e.dv==di);
const me=entries.splice(meIdx,1)[0];
entries.splice(10,0,me);
cars=entries.map((e,k)=>{const i=(N-3-2*k+N)%N,a=Math.atan2(pts[(i+1)%N][1]-pts[i][1],pts[(i+1)%N][0]-pts[i][0]),o=(k%2?1:-1)*9;
return{t:e.t,dv:DR[e.t][e.dv],pl:e.t==pi&&e.dv==di,x:pts[i][0]-Math.sin(a)*o,y:pts[i][1]+Math.cos(a)*o,a,v:0,idx:i,cr:0,off:0,fin:0,mx:270*TM[e.t][2]*(e.dv?0.985:1),sk:.9+Math.random()*.06,tire:1,pit:0,want:0,stop:0,pf:0,done:0,dnf:0,rel:1,dnfT:0,dmg:0}});
